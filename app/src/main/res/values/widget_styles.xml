<resources>
    <style name="WidgetPrayerName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">#F5F7F3</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9dp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1dp</item>
    </style>
    <style name="WidgetPrayerTime">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1.1</item>
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:layoutDirection">ltr</item>
        <item name="android:textColor">#F5F7F3</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9dp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1dp</item>
    </style>
    <style name="WidgetPrayerNameSmall" parent="WidgetPrayerName">
        <item name="android:autoSizeMaxTextSize">13sp</item>
    </style>
    <style name="WidgetPrayerTimeSmall" parent="WidgetPrayerTime">
        <item name="android:autoSizeMaxTextSize">13sp</item>
    </style>
    <style name="WidgetPrayerNameLarge" parent="WidgetPrayerName">
        <item name="android:autoSizeMaxTextSize">18sp</item>
    </style>
    <style name="WidgetPrayerTimeLarge" parent="WidgetPrayerTime">
        <item name="android:autoSizeMaxTextSize">18sp</item>
    </style>
    <!-- Arabic tall rows fill the available height; the text may grow with it. -->
    <style name="WidgetPrayerNameArabic" parent="WidgetPrayerName">
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:autoSizeMaxTextSize">22sp</item>
    </style>
    <style name="WidgetPrayerTimeArabic" parent="WidgetPrayerTime">
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:autoSizeMaxTextSize">24sp</item>
    </style>
    <style name="WidgetPrayerNameArabicSmall" parent="WidgetPrayerNameArabic">
        <item name="android:autoSizeMaxTextSize">18sp</item>
    </style>
    <style name="WidgetPrayerTimeArabicSmall" parent="WidgetPrayerTimeArabic">
        <item name="android:autoSizeMaxTextSize">20sp</item>
    </style>
    <style name="WidgetPrayerNameArabicLarge" parent="WidgetPrayerNameArabic">
        <item name="android:autoSizeMaxTextSize">26sp</item>
    </style>
    <style name="WidgetPrayerTimeArabicLarge" parent="WidgetPrayerTimeArabic">
        <item name="android:autoSizeMaxTextSize">28sp</item>
    </style>
</resources>

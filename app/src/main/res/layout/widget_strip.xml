<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" android:src="@drawable/widget_dark_green" />
  <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="3dp" android:orientation="vertical">
      <TextView android:id="@+id/widget_meta" style="@style/WidgetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:text="Abu Dhabi" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_prayer_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
      <LinearLayout android:id="@+id/widget_fajr_row" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/widget_fajr_name" style="@style/WidgetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Fajr" />
        <TextView android:id="@+id/widget_fajr_time" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:text="—" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_dhuhr_row" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/widget_dhuhr_name" style="@style/WidgetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Dhuhr" />
        <TextView android:id="@+id/widget_dhuhr_time" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:text="—" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_asr_row" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/widget_asr_name" style="@style/WidgetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Asr" />
        <TextView android:id="@+id/widget_asr_time" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:text="—" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_maghrib_row" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/widget_maghrib_name" style="@style/WidgetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Maghrib" />
        <TextView android:id="@+id/widget_maghrib_time" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:text="—" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_isha_row" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/widget_isha_name" style="@style/WidgetName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Isha" />
        <TextView android:id="@+id/widget_isha_time" style="@style/WidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:text="—" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>

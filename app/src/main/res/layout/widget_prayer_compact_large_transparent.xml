<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout
    android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
>
    <TextView android:id="@+id/widget_label"
        android:layout_width="match_parent" android:layout_height="14dp" android:layout_weight="0"
        android:text="NEXT · ABU DHABI" android:textColor="#E6D39E" android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowRadius="1.5" android:shadowDy="0.6"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1dp" />
    <TextView android:id="@+id/widget_next_name"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="23"
        android:text="Maghrib" android:textColor="#F5F7F3" android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowRadius="1.5" android:shadowDy="0.6"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10dp" android:autoSizeMaxTextSize="29sp" android:autoSizeStepGranularity="1dp" />
    <TextView android:id="@+id/widget_next_time"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="31"
        android:text="18:03" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
        android:gravity="center_vertical" android:layoutDirection="ltr" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowRadius="1.5" android:shadowDy="0.6"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12dp" android:autoSizeMaxTextSize="43sp" android:autoSizeStepGranularity="1dp" />
    <Chronometer android:id="@+id/widget_iqamah_countdown"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="28"
        android:visibility="gone" android:countDown="true" android:textColor="#E6D39E"
        android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layoutDirection="ltr"
        android:gravity="start|center_vertical" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowRadius="1.5" android:shadowDy="0.6"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12dp" android:autoSizeMaxTextSize="29sp" android:autoSizeStepGranularity="1dp" />
    <TextView android:id="@+id/widget_meta"
        android:layout_width="match_parent" android:layout_height="14dp" android:layout_weight="0"
        android:text="Today · UAE time" android:textColor="#E6D39E"
        android:gravity="start|center_vertical" android:maxLines="2" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowRadius="1.5" android:shadowDy="0.6"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1dp" />
    <TextView android:id="@+id/widget_source"
        android:layout_width="match_parent" android:layout_height="14dp" android:layout_weight="0"
        android:text="AWQAF · ABU DHABI" android:textColor="#AFC2B7"
        android:gravity="start|center_vertical" android:maxLines="1" android:includeFontPadding="false" android:shadowColor="#80000000" android:shadowRadius="1.5" android:shadowDy="0.6"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1dp" />
</LinearLayout>

</FrameLayout>
